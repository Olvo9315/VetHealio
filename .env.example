DATABASE_URL="postgresql://user:password@host:5432/vethealio?schema=public"
# Optional: max DB connections per server instance (1 for `prisma dev`)
DATABASE_POOL_MAX=

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# File storage: "db" (default, files in Postgres) or "fs" (local disk, e.g. a VPS volume)
STORAGE_DRIVER="db"
STORAGE_DIR="./storage"

# Resend (email notifications, optional)
RESEND_API_KEY=""

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seed (npm run db:seed) — first admin and clinic name for a new instance
SEED_CLINIC_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_FIRST_NAME=""
SEED_ADMIN_LAST_NAME=""
# Leave empty to generate a random password (printed once)
SEED_ADMIN_PASSWORD=""
