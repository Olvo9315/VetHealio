generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VETERINARIAN
  RECEPTIONIST
  ASSISTANT
}

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  REPTILE
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  // Checked in at reception: in the waiting room
  ARRIVED
}

enum AppointmentType {
  CONSULTATION
  SURGERY
  VACCINATION
  GROOMING
  CHECKUP
  OTHER
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  BIZUM
}

// Spanish fiscal documents: simplified (ticket), full (with the customer's NIF), rectifying
enum InvoiceKind {
  SIMPLIFIED
  FULL
  RECTIFYING
}

enum InvoiceItemType {
  CONSULTATION
  MEDICATION
  SERVICE
  OTHER
}

enum SalaryType {
  HOURLY
  MONTHLY
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum LeaveType {
  VACATION
  UNPAID_LEAVE
  AGREEMENT
  SICK_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  password              String
  name                  String
  firstName             String   @default("")
  lastName              String   @default("")
  role                  Role     @default(RECEPTIONIST)
  avatar                String?
  phone                 String?
  language              String   @default("es")
  theme                 String   @default("light")
  accent                String   @default("green")
  googleCalendarEnabled Boolean  @default(false)
  googleRefreshToken    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  appointments        Appointment[]       @relation("VeterinarianAppointments")
  medicalRecords      MedicalRecord[]
  vaccinations        Vaccination[]
  prescriptions       Prescription[]
  accounts            Account[]
  sessions            Session[]
  staffProfile        StaffProfile?
  staffShifts         StaffShift[]
  reviewedLeaves      LeaveRequest[]      @relation("LeaveReviewer")
  performanceReviews  PerformanceReview[] @relation("PerformanceReviewer")
  staffAuditLogs      StaffAuditLog[]     @relation("StaffAuditor")
  appointmentsCreated Appointment[]       @relation("AppointmentCreatedBy")
  appointmentsUpdated Appointment[]       @relation("AppointmentUpdatedBy")
  paymentsReceived    Payment[]           @relation("PaymentReceivedBy")
  paymentsVoided      Payment[]           @relation("PaymentVoidedBy")
  adviserExports      AdviserExport[]     @relation("AdviserExportBy")
  fiscalDocuments     FiscalDocument[]
  stockMovements      StockMovement[]
  consentsRecorded    Consent[]
  consentRequests     ConsentRequest[]    @relation("ConsentRequestBy")
}

model StaffProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialization  String?
  licenseNumber   String?
  education       String?
  diplomaPath     String?
  contractPath    String?
  salaryAmount    Float?
  salaryType      SalaryType   @default(MONTHLY)
  hireDate        DateTime?
  contractType    ContractType @default(FULL_TIME)
  isActive        Boolean      @default(true)
  canManageStaff  Boolean      @default(false)
  annualLeaveDays Int          @default(21)
  weeklyTemplate  Json?
  emergencyName   String?
  emergencyPhone  String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  leaveRequests      LeaveRequest[]
  certifications     StaffCertification[]
  performanceReviews PerformanceReview[]
  auditLogs          StaffAuditLog[]
}

model StaffShift {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, startTime])
}

model LeaveRequest {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  type           LeaveType
  startDate      DateTime
  endDate        DateTime
  reason         String?
  status         LeaveStatus  @default(PENDING)
  reviewedById   String?
  reviewedBy     User?        @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([staffProfileId, status])
}

model StaffCertification {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  name           String
  issuedBy       String?
  issuedDate     DateTime?
  expiryDate     DateTime?
  documentPath   String?
  notifiedAt     DateTime?
  createdAt      DateTime     @default(now())
}

model PerformanceReview {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User         @relation("PerformanceReviewer", fields: [reviewerId], references: [id])
  period         String
  score          Int?
  comment        String?
  createdAt      DateTime     @default(now())
}

model StaffAuditLog {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  changedById    String
  changedBy      User         @relation("StaffAuditor", fields: [changedById], references: [id])
  field          String
  oldValue       String?
  newValue       String?
  createdAt      DateTime     @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Owner {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  phone            String
  phone2           String?
  email            String?
  postalCode       String?
  address          String?
  notes            String?
  // DNI/NIE/NIF, needed on full invoices
  nif              String?
  // Communications the owner agreed to
  marketingConsent Boolean  @default(false)
  remindersConsent Boolean  @default(true)
  createdAt        DateTime @default(now())

  pets            Pet[]
  consents        Consent[]
  consentRequests ConsentRequest[]
}

model Pet {
  id              String    @id @default(cuid())
  number          Int       @default(autoincrement())
  name            String
  species         Species
  breed           String?
  color           String?
  birthDate       DateTime?
  weight          Float?
  gender          Gender?
  microchipNumber String?
  passportNumber  String?
  sterilized      Boolean?
  photoUrl        String?
  // Shown prominently wherever the patient is open (aggressive, allergic to...)
  alerts          String?
  // Chronic conditions / groups (keys from lib/pet-conditions.ts or free text)
  conditions      String[]  @default([])
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownerId        String
  owner          Owner           @relation(fields: [ownerId], references: [id])
  medicalRecords MedicalRecord[]
  appointments   Appointment[]
  vaccinations   Vaccination[]
  invoices       Invoice[]
  prescriptions  Prescription[]

  @@index([ownerId])
  @@index([isActive, updatedAt])
}

model Appointment {
  id             String            @id @default(cuid())
  number         Int               @default(autoincrement())
  title          String
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(SCHEDULED)
  type           AppointmentType?  @default(CONSULTATION)
  notes          String?
  googleEventId  String?
  // When the patient was checked in (status ARRIVED)
  arrivedAt      DateTime?
  // Owner was reminded of the appointment
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String?
  createdBy      User?             @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?             @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  petId          String
  pet            Pet                  @relation(fields: [petId], references: [id])
  veterinarianId String
  veterinarian   User                 @relation("VeterinarianAppointments", fields: [veterinarianId], references: [id])
  // First (main) service: drives the calendar colour; further services are in extraServices
  serviceId      String?
  service        Service?             @relation(fields: [serviceId], references: [id])
  extraServices  AppointmentService[]
  roomId         String?
  room           Room?                @relation(fields: [roomId], references: [id])
  invoice        Invoice?
  prescriptions  Prescription[]
  medicalRecords MedicalRecord[]

  @@index([startTime, endTime])
  @@index([petId])
  @@index([veterinarianId])
  @@index([roomId, startTime])
}

// Additional services of an appointment (the first one is Appointment.serviceId)
model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  sortOrder     Int         @default(0)

  @@index([appointmentId])
}

model MedicalRecord {
  id                   String   @id @default(cuid())
  date                 DateTime @default(now())
  chiefComplaint       String
  diagnosis            String?
  treatment            String?
  weight               Float?
  temperature          Float?
  heartRate            Int?
  notes                String?
  // Symptoms / clinical signs and the working diagnosis before the definitive one
  clinicalSigns        String?
  presumptiveDiagnosis String?
  // Physical exam: [{ key, label?, status: "normal" | "abnormal" | null, note? }]
  exam                 Json?
  // Instructions for the owner at home (printed / sent)
  homeCare             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  petId          String
  pet            Pet            @relation(fields: [petId], references: [id])
  veterinarianId String
  veterinarian   User           @relation(fields: [veterinarianId], references: [id])
  prescriptions  Prescription[]
  attachments    Attachment[]
  // Visit this record documents (filled in from it)
  appointmentId  String?
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([petId, date])
  @@index([appointmentId])
}

model Prescription {
  id        String   @id @default(cuid())
  number    Int      @default(autoincrement())
  notes     String?
  createdAt DateTime @default(now())

  // Legacy fields (for prescriptions created via MedicalRecord)
  medicationName String?
  dosage         String?
  frequency      String?
  duration       String?

  petId           String?
  pet             Pet?           @relation(fields: [petId], references: [id])
  veterinarianId  String?
  veterinarian    User?          @relation(fields: [veterinarianId], references: [id])
  appointmentId   String?
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id])
  medicalRecordId String?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)

  items PrescriptionItem[]

  // PRESVET (national register of antibiotic prescriptions): PENDING when it has antibiotics to
  // report, SENT once communicated; null when there is nothing to report
  presvetStatus String?
  presvetSentAt DateTime?
  // Reference returned by PRESVET (or the batch it went out in)
  presvetRef    String?

  @@index([petId, createdAt])
  @@index([appointmentId])
  @@index([presvetStatus])
}

model PrescriptionItem {
  id               String  @id @default(cuid())
  medicationName   String
  units            String?
  activeIngredient String?
  posology         String
  indications      String?
  warnings         String?
  // PRESVET data (antibiotics): national code, route, days, packages, purpose, exceptional use
  antibiotic       Boolean @default(false)
  nationalCode     String?
  route            String?
  treatmentDays    Int?
  packages         Float?
  // THERAPEUTIC | PROPHYLACTIC | METAPHYLACTIC
  purpose          String?
  // Exceptional prescription (cascade / off-label use)
  exceptional      Boolean @default(false)

  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model Vaccination {
  id               String    @id @default(cuid())
  vaccineName      String
  dateAdministered DateTime
  nextDueDate      DateTime?
  batchNumber      String?
  notes            String?
  // Owner was reminded of nextDueDate (WhatsApp / e-mail)
  reminderSentAt   DateTime?
  createdAt        DateTime  @default(now())

  petId          String
  pet            Pet    @relation(fields: [petId], references: [id])
  veterinarianId String
  veterinarian   User   @relation(fields: [veterinarianId], references: [id])

  @@index([petId])
}

model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())

  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String         @id @default(cuid())
  number        Int            @default(autoincrement())
  status        InvoiceStatus  @default(PENDING)
  totalAmount   Float
  // Sum of payments; PAID once it reaches totalAmount
  paidAmount    Float          @default(0)
  // Method of the last payment
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  createdAt     DateTime       @default(now())

  payments       Payment[]
  documents      FiscalDocument[]
  stockMovements StockMovement[]

  petId         String
  pet           Pet           @relation(fields: [petId], references: [id])
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  items         InvoiceItem[]

  @@index([petId])
  @@index([status, createdAt])
}

// Fiscal document issued for a bill (Spain): a numbered, never edited snapshot.
// SIMPLIFIED = ticket; FULL = with the customer's NIF (may replace a ticket); RECTIFYING = cancels
// or corrects an earlier document, with negative amounts.
model FiscalDocument {
  id              String      @id @default(cuid())
  kind            InvoiceKind
  series          String
  year            Int
  number          Int
  issuedAt        DateTime    @default(now())
  customerName    String
  customerNif     String?
  customerAddress String?
  // [{ description, quantity, unitPrice, taxRate, total }], VAT included in prices
  lines           Json
  // [{ rate, base, tax }]
  taxBreakdown    Json
  taxBase         Float
  taxAmount       Float
  total           Float
  reason          String?

  invoiceId  String
  invoice    Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  replacesId String?
  replaces   FiscalDocument?  @relation("Replaces", fields: [replacesId], references: [id])
  replacedBy FiscalDocument[] @relation("Replaces")
  issuedById String?
  issuedBy   User?            @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  // First time it went to the tax adviser
  exportId   String?
  export     AdviserExport?   @relation(fields: [exportId], references: [id], onDelete: SetNull)

  @@unique([series, year, number])
  @@index([issuedAt])
  @@index([invoiceId])
}

// A period of issued invoices handed to the tax adviser (gestor): sent by e-mail or downloaded and
// marked as sent. Documents keep the first export they went out in.
model AdviserExport {
  id          String           @id @default(cuid())
  periodFrom  DateTime
  periodTo    DateTime
  // EMAIL | MANUAL
  method      String
  sentTo      String?
  docCount    Int
  total       Float
  createdAt   DateTime         @default(now())
  createdById String?
  createdBy   User?            @relation("AdviserExportBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents   FiscalDocument[]

  @@index([createdAt])
}

model Payment {
  id         String        @id @default(cuid())
  // Negative for a refund
  amount     Float
  method     PaymentMethod
  paidAt     DateTime      @default(now())
  note       String?
  createdAt  DateTime      @default(now())
  // A payment entered by mistake is voided, never deleted: it stays visible with who, when and why
  voidedAt   DateTime?
  voidReason String?
  voidedById String?
  voidedBy   User?         @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedById String?
  receivedBy   User?   @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paidAt])
}

model InvoiceItem {
  id              String           @id @default(cuid())
  description     String
  quantity        Int
  unitPrice       Float
  total           Float
  type            InvoiceItemType? @default(SERVICE)
  // VAT included in unitPrice, %
  taxRate         Float            @default(21)
  serviceId       String?
  service         Service?         @relation(fields: [serviceId], references: [id])
  // Product from stock: saving the invoice takes it out of stock
  inventoryItemId String?
  inventoryItem   InventoryItem?   @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Service {
  id           String    @id @default(cuid())
  // Official name, in the clinic's data language (used on invoices and documents)
  name         String
  // Optional display names for other UI languages: { "ru": "...", "en": "..." }
  translations Json?
  price        Float?
  color        String?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  parentId     String?
  parent       Service?  @relation("ServiceTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Service[] @relation("ServiceTree")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  appointments      Appointment[]
  appointmentExtras AppointmentService[]
  invoiceItems      InvoiceItem[]
}

model InventoryItem {
  id         String    @id @default(cuid())
  name       String
  category   String
  quantity   Float
  unit       String
  minStock   Float     @default(0)
  unitCost   Float?
  expiryDate DateTime?
  supplier   String?
  notes      String?
  // Barcode / national code (CN) to find it when receiving or selling
  barcode    String?
  salePrice  Float?
  taxRate    Float?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  batches      InventoryBatch[]
  movements    StockMovement[]
  invoiceItems InvoiceItem[]
}

// Stock of one lot of an item (traceability and expiry)
model InventoryBatch {
  id         String    @id @default(cuid())
  lot        String?
  expiryDate DateTime?
  quantity   Float
  createdAt  DateTime  @default(now())

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([expiryDate])
}

// Every change of stock: RECEIPT (supplier delivery), SALE (invoice line), ADJUST (manual)
model StockMovement {
  id         String    @id @default(cuid())
  delta      Float
  reason     String
  lot        String?
  expiryDate DateTime?
  unitCost   Float?
  supplier   String?
  // Supplier's invoice / delivery note number
  document   String?
  createdAt  DateTime  @default(now())

  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([invoiceId])
}

// Data-protection (RGPD) consent of an owner: the text they accepted and how
// A document sent to the owner to sign on their own phone: a private link (WhatsApp / e-mail) that
// works once and expires. Signing it creates the Consent.
model ConsentRequest {
  id          String    @id @default(cuid())
  token       String    @unique
  kind        String
  text        String
  lang        String
  petIds      String[]  @default([])
  details     Json?
  signerName  String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  signedAt    DateTime?
  cancelledAt DateTime?

  ownerId     String
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation("ConsentRequestBy", fields: [createdById], references: [id], onDelete: SetNull)
  consentId   String?  @unique
  consent     Consent? @relation(fields: [consentId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model Consent {
  id           String   @id @default(cuid())
  // rgpd | general | surgery | hospitalization | euthanasia | necropsy (lib/consents.ts)
  kind         String   @default("rgpd")
  text         String
  marketing    Boolean  @default(false)
  // Pets a treatment consent covers (one owner may sign for several at once)
  petIds       String[] @default([])
  // Treatment consents: { procedure, risks, alternatives, cost, vetName, vetLicense }
  details      Json?
  // Who signed, when it is not the owner (authorised person)
  signerName   String?
  // SIGNATURE (drawn on screen) or CHECKBOX
  method       String
  signatureKey String?
  signedAt     DateTime @default(now())
  userAgent    String?

  ownerId        String
  owner          Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recordedById   String?
  recordedBy     User?           @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  consentRequest ConsentRequest?

  @@index([ownerId])
}

// Singleton row (id = "default") with this clinic's identity, used for branding and invoices
model ClinicSettings {
  id                 String   @id @default("default")
  name               String   @default("VetHealio")
  legalName          String?
  nif                String?
  registrationNumber String?
  address            String?
  postalCode         String?
  city               String?
  province           String?
  country            String   @default("España")
  phone              String?
  email              String?
  website            String?
  logoKey            String?
  iban               String?
  defaultTaxRate     Float    @default(21)
  // Prices in the catalogue and on bills are entered with VAT included (consumer prices) or before VAT
  pricesIncludeTax   Boolean  @default(true)
  invoiceFooter      String?
  // Physical exam rows offered in a medical record (keys of lib/exam.ts or custom labels)
  examTemplate       Json?
  // RGPD text owners accept (a default from messages when empty)
  consentText        String?
  // Prefixes of the fiscal invoice series
  seriesSimplified   String   @default("T")
  seriesFull         String   @default("F")
  seriesRectifying   String   @default("R")
  // Tax adviser (gestor) who receives the invoice book
  adviserEmail       String?
  // Signed module license (see lib/license.ts)
  licenseKey         String?
  // Language of official data (service names, invoices, documents): es | ru | en
  dataLocale         String   @default("es")
  updatedAt          DateTime @updatedAt
}

// File contents for STORAGE_DRIVER=db (default on Vercel, where there is no persistent disk)
model StoredFile {
  key         String   @id
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}

// Consulting rooms / operating theatres; an appointment can be booked into one
model Room {
  id           String        @id @default(cuid())
  name         String
  color        String        @default("#1D9E75")
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}
