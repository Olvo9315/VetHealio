generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VETERINARIAN
  RECEPTIONIST
  ASSISTANT
}

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  REPTILE
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  SURGERY
  VACCINATION
  GROOMING
  CHECKUP
  OTHER
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum InvoiceItemType {
  CONSULTATION
  MEDICATION
  SERVICE
  OTHER
}

enum SalaryType {
  HOURLY
  MONTHLY
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum LeaveType {
  VACATION
  UNPAID_LEAVE
  AGREEMENT
  SICK_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  password              String
  name                  String
  firstName             String   @default("")
  lastName              String   @default("")
  role                  Role     @default(RECEPTIONIST)
  avatar                String?
  phone                 String?
  language              String   @default("es")
  theme                 String   @default("light")
  googleCalendarEnabled Boolean  @default(false)
  googleRefreshToken    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  appointments        Appointment[]   @relation("VeterinarianAppointments")
  medicalRecords      MedicalRecord[]
  vaccinations        Vaccination[]
  accounts            Account[]
  sessions            Session[]
  staffProfile        StaffProfile?
  staffShifts         StaffShift[]
  reviewedLeaves      LeaveRequest[]      @relation("LeaveReviewer")
  performanceReviews  PerformanceReview[] @relation("PerformanceReviewer")
  staffAuditLogs      StaffAuditLog[]     @relation("StaffAuditor")
}

model StaffProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialization String?
  licenseNumber  String?
  education      String?
  diplomaPath    String?
  contractPath   String?
  salaryAmount   Float?
  salaryType     SalaryType   @default(MONTHLY)
  hireDate       DateTime?
  contractType   ContractType @default(FULL_TIME)
  isActive       Boolean      @default(true)
  canManageStaff Boolean      @default(false)
  annualLeaveDays Int         @default(21)
  weeklyTemplate Json?
  emergencyName  String?
  emergencyPhone String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leaveRequests      LeaveRequest[]
  certifications     StaffCertification[]
  performanceReviews PerformanceReview[]
  auditLogs          StaffAuditLog[]
}

model StaffShift {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  note      String?
  createdAt DateTime @default(now())
}

model LeaveRequest {
  id             String      @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  type           LeaveType
  startDate      DateTime
  endDate        DateTime
  reason         String?
  status         LeaveStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model StaffCertification {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  name           String
  issuedBy       String?
  issuedDate     DateTime?
  expiryDate     DateTime?
  documentPath   String?
  notifiedAt     DateTime?
  createdAt      DateTime     @default(now())
}

model PerformanceReview {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User         @relation("PerformanceReviewer", fields: [reviewerId], references: [id])
  period         String
  score          Int?
  comment        String?
  createdAt      DateTime     @default(now())
}

model StaffAuditLog {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  changedById    String
  changedBy      User         @relation("StaffAuditor", fields: [changedById], references: [id])
  field          String
  oldValue       String?
  newValue       String?
  createdAt      DateTime     @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Owner {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  pets Pet[]
}

model Pet {
  id              String    @id @default(cuid())
  name            String
  species         Species
  breed           String?
  color           String?
  birthDate       DateTime?
  weight          Float?
  gender          Gender?
  microchipNumber String?
  photoUrl        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownerId        String
  owner          Owner           @relation(fields: [ownerId], references: [id])
  medicalRecords MedicalRecord[]
  appointments   Appointment[]
  vaccinations   Vaccination[]
  invoices       Invoice[]
}

model Appointment {
  id            String            @id @default(cuid())
  title         String
  startTime     DateTime
  endTime       DateTime
  status        AppointmentStatus @default(SCHEDULED)
  type          AppointmentType   @default(CONSULTATION)
  notes         String?
  googleEventId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  petId          String
  pet            Pet     @relation(fields: [petId], references: [id])
  veterinarianId String
  veterinarian   User    @relation("VeterinarianAppointments", fields: [veterinarianId], references: [id])
  invoice        Invoice?
}

model MedicalRecord {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  chiefComplaint String
  diagnosis      String?
  treatment      String?
  weight         Float?
  temperature    Float?
  heartRate      Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  petId          String
  pet            Pet            @relation(fields: [petId], references: [id])
  veterinarianId String
  veterinarian   User           @relation(fields: [veterinarianId], references: [id])
  prescriptions  Prescription[]
  attachments    Attachment[]
}

model Prescription {
  id             String @id @default(cuid())
  medicationName String
  dosage         String
  frequency      String
  duration       String
  notes          String?

  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
}

model Vaccination {
  id               String    @id @default(cuid())
  vaccineName      String
  dateAdministered DateTime
  nextDueDate      DateTime?
  batchNumber      String?
  notes            String?
  createdAt        DateTime  @default(now())

  petId          String
  pet            Pet    @relation(fields: [petId], references: [id])
  veterinarianId String
  veterinarian   User   @relation(fields: [veterinarianId], references: [id])
}

model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())

  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String         @id @default(cuid())
  status        InvoiceStatus  @default(PENDING)
  totalAmount   Float
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  createdAt     DateTime       @default(now())

  petId         String
  pet           Pet            @relation(fields: [petId], references: [id])
  appointmentId String?        @unique
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  items         InvoiceItem[]
}

model InvoiceItem {
  id          String          @id @default(cuid())
  description String
  quantity    Int
  unitPrice   Float
  total       Float
  type        InvoiceItemType @default(SERVICE)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id         String    @id @default(cuid())
  name       String
  category   String
  quantity   Float
  unit       String
  minStock   Float     @default(0)
  unitCost   Float?
  expiryDate DateTime?
  supplier   String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
